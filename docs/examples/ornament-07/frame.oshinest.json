      "source": "const W=65,D=95,H=12,r=7;\nconst frameW=7,openW=W-18,openD=D-22;\n// 長方形角丸枠\nconst outer=roundedBox([W,D,H],r);\nconst inner=move(roundedBox([openW,openD,H+1.6],r-2),[(W-openW)/2,(D-openD)/2,-0.8]);\nconst base=subtract(outer,inner);\n// 四隅:ベース点\nconst cx=[r,r,W-r,W-r],cy=[D-r,r,r,D-r];\n// 各装飾のZ範囲をH内に統一\n// topLeft装飾\nconst topLeft=union(\n  stroke([[14,12,3],[9,16,6],[6,23,7],[12,31,4]],[3.4,3.9,2.2,1.3],0.6),\n  stroke([[12,7,6],[2,9,7],[7,22,8],[11,12,4]],[3.6,2.8,2.1,1.5],0.5),\n  stroke([[17,10,8],[7,1,6],[7,14,7],[14,19,4]],[2.8,2.2,1.6,1],0.36),\n  // 抜け穴\n  subtract(box([8,7,H]),move(cylinder(H,2.4),[11,9,0]))\n);\n// topRight装飾\nconst topRight=union(\n  stroke([[W-13,7,7],[W-1,3,7],[W-14,30,7],[W-18,25,4]],[3,2.6,1.9,1],0.52),\n  stroke([[W-11,12,6],[W-1,19,8],[W-9,24,8],[W-19,17,4]],[2.1,2.1,2,1.2],0.5),\n  subtract(move(box([9,6,H]),[W-10,6,0]),move(cylinder(H,2.5),[W-7,13,0]))\n);\n// bottomLeft装飾\nconst bottomLeft=union(\n  stroke([[11,D-12,9],[4,D-9,7],[2,D-25,10],[10,D-28,4]],[3.3,3.2,2.1,1.1],0.68),\n  stroke([[19,D-8,7],[11,D-2,9],[2,D-21,9],[14,D-21,4]],[2.7,2.5,1.6,1.2],0.6),\n  subtract(box([8,8,H]),move(cylinder(H,2.6),[12,D-9,0]))\n);\n// bottomRight装飾\nconst bottomRight=union(\n  stroke([[W-14,D-6,7],[W-3,D-7,7],[W-13,D-23,10],[W-18,D-21,3]],[2.7,2.6,1.7,1],0.7),\n  stroke([[W-11,D-11,7],[W-1,D-16,7],[W-14,D-27,8],[W-13,D-18,4]],[2.6,2,1.5,1],0.5),\n  subtract(box([7,10,H]),move(cylinder(H,2.2),[W-8,D-13,0]))\n);\nreturn union(base,topLeft,topRight,bottomLeft,bottomRight);"
