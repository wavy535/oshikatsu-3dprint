# Local Docker Compose services. These credentials are for local development only.
DATABASE_URL=postgresql://app_runtime:local-app-password@127.0.0.1:55432/oshinest
MIGRATION_DATABASE_URL=postgresql://postgres:local-postgres-password@127.0.0.1:55432/oshinest
# On AWS: /app/certs/rds-global-bundle.pem (included in the image)
DATABASE_SSL_CA=
SITE_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
AUTH_SECRET=
MAIL_PROVIDER=mailpit
MAILPIT_URL=http://127.0.0.1:58025
MAIL_FROM=
# Local SMS codes appear in Mailpit. AWS uses SMS_PROVIDER=sns.
SMS_PROVIDER=mailpit
# Only the local S3 signing region. Choose the AWS workload region when deploying.
AWS_REGION=us-east-1
S3_BUCKET=oshinest-local
S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY_ID=local-access-key
S3_SECRET_ACCESS_KEY=local-secret-key

# Isolated guest demo only; regular environments keep this false.
DEMO_GUEST_ENABLED=false
# Set to s3 on Lambda to redirect generated AR files outside buffered responses.
AR_MODEL_STORAGE=inline
