{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshinest",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "placement": { "mode": "smart" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "oshinest-files" }],
  "hyperdrive": [{
    "binding": "DATABASE",
    "id": "00000000000000000000000000000000",
    "localConnectionString": "postgresql://app_runtime:local-app-password@127.0.0.1:55432/oshinest"
  }],
  "services": [{ "binding": "GEOMETRY", "service": "oshinest-geometry" }],
  "vars": {
    "SITE_URL": "https://configure-before-deploy.invalid",
    "MAIL_PROVIDER": "none",
    "SMS_PROVIDER": "none",
    "DEMO_GUEST_ENABLED": "false",
    "AR_MODEL_STORAGE": "r2",
    "APP_RUNTIME": "cloudflare"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
