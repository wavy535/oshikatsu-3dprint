{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oshinest",
  "account_id": "1c93af48e1a5c2e163edc9030cff4647",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // D1's primary is in SIN. Smart Placement had INSUFFICIENT_INVOCATIONS,
  // leaving every database round trip to cross regions on low-traffic pages.
  // This is a Cloudflare placement hint; it does not create/use AWS resources.
  "placement": { "region": "aws:ap-southeast-1" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "oshinest-files" }],
  "d1_databases": [{
    "binding": "DATABASE",
    "database_name": "oshinest",
    "database_id": "f0c7b9d1-1af4-4553-a2ef-bb42e65036ca",
    "migrations_dir": "db/d1"
  }],
  "services": [{ "binding": "GEOMETRY", "service": "oshinest-geometry" }],
  "vars": {
    "SITE_URL": "https://oshinest.yumaboda-official.workers.dev",
    "MAIL_PROVIDER": "none",
    "AUTH_EMAIL_VERIFICATION": "disabled",
    "CREATOR_APPLICATIONS_ENABLED": "false",
    "DEMO_GUEST_ENABLED": "false",
    "AR_MODEL_STORAGE": "r2",
    "APP_RUNTIME": "cloudflare"
  },
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
