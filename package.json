{
  "name": "osinest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark:print": "node --experimental-strip-types scripts/benchmark-print.ts",
    "analyze": "node --experimental-strip-types scripts/analyze-file.ts",
    "test:db": "node scripts/db.mjs test",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:seed": "node scripts/db.mjs seed && node scripts/seed-storage.mjs",
    "db:types": "node scripts/db-types.mjs",
    "dev:services": "docker compose up -d --build --wait",
    "perf:frontend": "node scripts/measure-frontend.mjs",
    "preview": "wrangler dev --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types --strict-vars=false --env-interface CloudflareEnv worker-configuration.d.ts",
    "dev:geometry": "wrangler dev --config infra/cloudflare/geometry/wrangler.jsonc --port 8788",
    "deploy": "node scripts/check-cloudflare-config.mjs && npm run build && wrangler deploy --config dist/server/wrangler.json",
    "deploy:geometry": "wrangler deploy --config infra/cloudflare/geometry/wrangler.jsonc",
    "check:compat": "vinext check",
    "db:seed:storage": "node scripts/seed-storage.mjs",
    "dev:geometry:local": "wrangler dev --config infra/local/geometry/wrangler.jsonc --port 8788"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@google/model-viewer": "^4.3.1",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "kysely": "^0.29.5",
    "lucide-react": "^1.40.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.183.2",
    "vinext": "1.0.0-beta.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.60.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vinext/cloudflare": "1.0.0-beta.11",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsonc-parser": "3.3.1",
    "next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "4.141.0"
  },
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "overrides": {
    "fflate@>=0.7.0 <0.7.5": "0.7.5"
  }
}
