{
  "DBClusterIdentifier": "oshinest-demo",
  "Engine": "aurora-postgresql",
  "EngineVersion": "<supported-17.x-version-in-target-region>",
  "DatabaseName": "oshinest",
  "MasterUsername": "oshinest_admin",
  "ManageMasterUserPassword": true,
  "DBSubnetGroupName": "<db-subnet-group>",
  "VpcSecurityGroupIds": ["<database-security-group>"],
  "StorageEncrypted": true,
  "BackupRetentionPeriod": 1,
  "ServerlessV2ScalingConfiguration": {
    "MinCapacity": 0,
    "MaxCapacity": 1,
    "SecondsUntilAutoPause": 300
  }
}
